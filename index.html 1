function openWelcome() {
  document.getElementById("welcome").classList.remove("hidden");
  goTo("welcome");
}

function goTo(id) {
  document.getElementById(id).scrollIntoView({
    behavior: "smooth",
    block: "center"
  });
}

function showLetter(key) {
  document.getElementById("letterTitle").textContent = letters[key].title;
  document.getElementById("letterText").textContent = letters[key].text;
  document.getElementById("letterBox").classList.remove("hidden");
  goTo("letterBox");
}
function hideLetter() {
  document.getElementById("letterBox").classList.add("hidden");
}

function memoryAnswer(kind) {
  const replies = {
    fun: "Dann müssen wir wohl noch mehr Unsinn sammeln. 😂♡",
    deep: "Die ehrlichen Gespräche sind etwas Besonderes. Danke, dass wir sie teilen können. 💌",
    all: "Das ist die beste Antwort. Die kleinen und großen Momente gehören alle dazu. ♡"
  };
  document.getElementById("memoryReply").textContent = replies[kind];
}

const reminders = [
  "Du musst nicht immer für alle stark sein. Auch du darfst Unterstützung annehmen. ♡",
  "Du darfst Fehler machen und trotzdem stolz darauf sein, dass du es versucht hast.",
  "Deine Gefühle verdienen es, ernst genommen zu werden.",
  "Du darfst dir Zeit nehmen, ohne dich dafür rechtfertigen zu müssen.",
  "Vergiss nicht, dir selbst dieselbe Freundlichkeit zu geben, die du anderen schenkst."
];
let reminderIndex = 0;

function nextReminder() {
  const box = document.getElementById("reminderBox");
  box.textContent = reminders[reminderIndex % reminders.length];
  reminderIndex++;
  box.classList.remove("hidden");
}

const questions = [
  {
    q: "Was macht unsere Gespräche besonders?",
    a: ["Unsere Insider", "Unsere ehrlichen Momente", "Die Mischung aus allem"],
    good: 2,
    note: "Die Mischung aus all den kleinen Dingen macht es besonders. ♡"
  },
  {
    q: "Was macht eine Erinnerung wertvoll?",
    a: ["Wie teuer sie war", "Wie perfekt sie aussah", "Wie sie sich anfühlt"],
    good: 2,
    note: "Genau! Es geht um das Gefühl, nicht um Perfektion. 💗"
  },
  {
    q: "Was darfst du an einem schweren Tag tun?",
    a: ["Dir eine Pause gönnen", "Perfekt sein müssen", "Alles alleine schaffen"],
    good: 0,
    note: "Richtig. Du darfst dir Zeit nehmen und Unterstützung annehmen. ♡"
  },
  {
    q: "Was ist das Wichtigste an diesem Geschenk?",
    a: ["Der teuerste Effekt", "Dass es perfekt ist", "Dass es mit Gedanken gemacht wurde"],
    good: 2,
    note: "Ganz genau. Es geht darum, dass ich mir Zeit für dich genommen habe. ❤️"
  }
];
let quizIndex = 0;

function answerQuiz(choice) {
  const question = questions[quizIndex];
  const result = document.getElementById("quizResult");
  result.textContent = choice === question.good
    ? "Richtige Antwort! " + question.note
    : "Gute Antwort! " + question.note;

  document.querySelectorAll("#quizAnswers button").forEach(button => {
    button.disabled = true;
    button.style.opacity = ".65";
  });
  document.getElementById("quizNext").classList.remove("hidden");
}

function nextQuiz() {
  quizIndex++;
  if (quizIndex >= questions.length) {
    document.getElementById("quizQuestion").textContent = "Du hast es geschafft! 🎉";
    document.getElementById("quizAnswers").innerHTML =
      "<p>Danke fürs Mitspielen. Hier gibt es nur Gewinner. ♡</p>";
    document.getElementById("quizResult").textContent =
      "Ich hoffe, du hattest ein kleines bisschen Spaß. 💗";
    document.getElementById("quizNext").classList.add("hidden");
    return;
  }

  const question = questions[quizIndex];
  document.getElementById("quizQuestion").textContent = question.q;
  document.getElementById("quizAnswers").innerHTML = question.a.map(
    (answer, i) =>
      `<button class="btn secondary" onclick="answerQuiz(${i})">${answer}</button>`
  ).join("");
  document.getElementById("quizResult").textContent = "";
  document.getElementById("quizNext").classList.add("hidden");
}

function checkSecret() {
  const value = document.getElementById("secretInput").value
    .trim().toLocaleLowerCase("de");
  if (value === "vertrauen") {
    document.getElementById("secretBox").classList.remove("hidden");
    document.getElementById("secretHint").textContent = "";
    goTo("secretBox");
  } else {
    document.getElementById("secretHint").textContent =
      "Noch nicht ganz! Tipp: Es ist wichtig, wenn man weit voneinander entfernt ist. ♡";
  }
}

function sendHearts() {
  const container = document.getElementById("floatingHearts");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reducedMotion) {
    document.getElementById("heartReply").textContent =
      "Ganz viele Herzen für dich! 💗💗💗";
    return;
  }

  for (let i = 0; i < 24; i++) {
    const heart = document.createElement("span");
    heart.className = "floating-heart";
    heart.textContent = ["♥", "♡", "💗"][i % 3];
    heart.style.left = Math.random() * 100 + "%";
    heart.style.fontSize = (16 + Math.random() * 23) + "px";
    heart.style.animationDelay = Math.random() * 1.5 + "s";
    container.appendChild(heart);
    heart.addEventListener("animationend", () => heart.remove());
  }

  document.getElementById("heartReply").textContent =
    "Ein ganzer Himmel voller Herzen. Nur für dich. ♡";
}

function createStars() {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const container = document.getElementById("floatingHearts");
  for (let i = 0; i < 10; i++) {
    const heart = document.createElement("span");
    heart.className = "floating-heart";
    heart.textContent = "♡";
    heart.style.left = Math.random() * 100 + "%";
    heart.style.fontSize = "12px";
    heart.style.opacity = ".3";
    heart.style.animationDuration = (7 + Math.random() * 7) + "s";
    heart.style.animationDelay = (Math.random() * 8) + "s";
    container.appendChild(heart);
    heart.addEventListener("animationend", () => heart.remove());
  }
}
createStars();
</script>
